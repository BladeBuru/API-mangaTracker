PORT=
NODE_ENV=

DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=
DATABASE_SCHEMA=

JWT_REFRESH_SECRET=
JWT_KEY=
JWT_REFRESH_SECRET_EXPIRES_IN=
JWT_KEY_EXPIRES_IN=

HTTP_TIMEOUT=
HTTP_MAX_REDIRECT=
ENABLE_DEBUG_MESSAGES_FOR_API_CLIENT=
DISABLE_ERROR_MESSAGES_FOR_API_CLIENT=
TYPEORM_DEBUG_LOGGING=

# ─── Traduction des descriptions (serveur) ──────────────────────
# Clé DeepL API Free (optionnelle) : si absente, fallback automatique sur
# l'endpoint Google gtx sans clé. https://www.deepl.com/pro-api
DEEPL_API_KEY=
# Timeout dur (ms) de la traduction synchrone au 1er visiteur ; au-delà,
# la description originale est renvoyée et la traduction se termine en
# arrière-plan pour le visiteur suivant.
TRANSLATION_TIMEOUT_MS=4000

# ─── Sync nightly du catalogue MangaUpdates ─────────────────────
# Cron 03:30 + jitter 0-15 min (CatalogSyncService). Défauts appliqués si
# les variables sont absentes (ENABLED est forcé à false si NODE_ENV=test).
# CATALOG_SYNC_PAGES_PER_RUN : budget de pages par nuit, REPARTI entre les
# shards (100 titres/page). C'est le SEUL frein de debit du catalogue.
# CATALOG_SYNC_YEAR_FLOOR : annee la plus ancienne parcourue. Defaut 1930
# (mesure : 1925 -> 0 hit, 1930 -> 1, 1950 -> 4).
# CATALOG_SYNC_SHARD_REFRESH_DAYS : au bout de combien de jours un shard
# termine est re-parcouru (defaut 30). Les passes globales et les 2 annees
# les plus recentes utilisent une fenetre courte de 7 j (nouveautes).
# CATALOG_SYNC_MAX_PAGES : DEPRECIEE et IGNOREE depuis le decoupage par
# annee. Elle servait de plafond absolu de pagination : la passe s'arretait
# page 50, se declarait terminee, remettait le curseur a 0 et reingerait
# eternellement les memes ~5000 titres. Ne pas la reintroduire.
# CATALOG_SYNC_DELAY_MS : délai entre 2 appels MU (2000 ms = 30 req/min).
# CATALOG_SYNC_HYDRATION_BUDGET : appels détail MU max/nuit pour hydrater les
# lignes `manga` incomplètes — genres, note, année OU cover manquants (stubs
# de recos inclus). 800 x 2 s ~= 27 min a 30 req/min, soit la moitie du
# plafond MU anonyme (~60 req/min). Une ligne deja tentee n'est reessayee
# qu'apres 30 jours (colonne `manga.hydration_attempted_at`), ce qui empeche
# le budget d'etre brule en boucle sur des titres que MU ne peut pas completer.
CATALOG_SYNC_ENABLED=true
CATALOG_SYNC_PAGES_PER_RUN=60
CATALOG_SYNC_DELAY_MS=2000
CATALOG_SYNC_YEAR_FLOOR=1930
CATALOG_SYNC_SHARD_REFRESH_DAYS=30
CATALOG_SYNC_HYDRATION_BUDGET=800

# --- Rattrapage de `manga.type` (CatalogTypeBackfillService) ------------
# Volet A au demarrage (+60 s) : relecture GET /series/{id} des titres en
# bibliotheque sans type (1 req / CATALOG_SYNC_DELAY_MS), plafonnee par
# CATALOG_TYPE_BACKFILL_LIBRARY_CAP. Volet B en cron 01:00 + jitter 0-10 min :
# recherche /series/search filtree par type (Manhwa puis Manhua) par annee
# decroissante, pages de 100, curseur `type:<T>:year:<AAAA>` dans
# catalog_sync_state, budget CATALOG_TYPE_BACKFILL_PAGES_PER_RUN pages/nuit
# (200 x 2 s ~= 7 min), disjoncteur apres 3 shards en echec. Un shard termine
# ne repasse jamais : le catalogue nightly persiste desormais `record.type`
# et maintient la colonne. Un seul job MU a la fois (verrou partage avec
# releases 02:00 et catalogue 03:30). ENABLED force a false si NODE_ENV=test.
CATALOG_TYPE_BACKFILL_ENABLED=true
CATALOG_TYPE_BACKFILL_PAGES_PER_RUN=200
CATALOG_TYPE_BACKFILL_YEAR_FLOOR=1950
CATALOG_TYPE_BACKFILL_TYPES=Manhwa,Manhua
CATALOG_TYPE_BACKFILL_LIBRARY_CAP=500

# ─── Signal de lecture public MangaUpdates (ReaderSignalModule) ──
#
# RGPD — READER_SIGNAL_HASH_SALT est un SECRET. Ne jamais le versionner, ne
# jamais le logger. Sans lui (ou s'il fait moins de 32 caracteres), la
# collecte reste DESACTIVEE : les identifiants de lecteurs MangaUpdates ne
# peuvent pas etre pseudonymises, donc rien n'est ecrit. C'est volontaire —
# un sel par defaut serait public et la pseudonymisation cosmetique.
# Generer avec : openssl rand -base64 48
# Changer le sel rend les anciens hash inutilisables (les memes lecteurs
# compteraient deux fois) : purger reader_signal + reader_profile apres une
# rotation.
READER_SIGNAL_HASH_SALT=
#
# Collecte, cron 05:30 + jitter 0-10 min. Creneaux MU deja pris : 01:00
# (type), 02:00 (sorties), 03:30 (catalogue), ~04:00 (hydratation). Verrou MU
# partage : un seul job MangaUpdates a la fois, quel qu'il soit.
# BUDGET_PER_RUN : requetes MU max par nuit (1000 x 2 s ~= 33 min).
# DISCOVERY_SHARE : part du budget reservee a la decouverte
#   (/lists/similar), le reste va a l'extraction des listes publiques.
# TYPE_DEPTH : profondeur exploree par type d'oeuvre (Manhwa, Manhua, Manga
#   a part egale). Sert AUSSI de perimetre au calcul des co-occurrences.
# READER_TTL_DAYS : un lecteur deja collecte n'est pas re-extrait avant.
# PER_PAGE : 1000 est le maximum reellement accepte par MU sur
#   /lists/public/{uid}/search/{lid} ; au-dela MU coerce silencieusement a 25.
READER_SIGNAL_ENABLED=true
READER_SIGNAL_BUDGET_PER_RUN=1000
READER_SIGNAL_DISCOVERY_SHARE=0.4
READER_SIGNAL_TYPE_DEPTH=1500
READER_SIGNAL_READER_TTL_DAYS=30
READER_SIGNAL_PER_PAGE=1000
READER_SIGNAL_MAX_LIST_PAGES=3
READER_SIGNAL_MAX_FAILURES=5
READER_SIGNAL_READER_MAX_FAILURES=3
#
# Agregation des co-occurrences, cron 06:30. Purement locale (aucun appel
# reseau, aucun quota MU). MIN_CO_READERS : lecteurs communs minimum pour
# qu'une paire soit conservee. MAX_VECTOR_SIZE : un lecteur ayant plus
# d'oeuvres que cela dans le perimetre est exclu (il a « tout lu », son
# apport est nul et il produit des millions de paires a lui seul).
# RAW_TTL_DAYS : purge des lignes BRUTES au-dela de N jours. 0 = desactivee.
# A activer (90 par exemple) une fois la ponderation stabilisee : les
# agregats survivent a la purge, c'est le geste de minimisation RGPD.
READER_SIGNAL_MIN_CO_READERS=3
READER_SIGNAL_MAX_VECTOR_SIZE=800
READER_SIGNAL_RAW_TTL_DAYS=0

# --- Graphe de recommandations MU (RecoGraphBackfillService) ------------
# Lit GET /series/{id} pour en persister les TROIS voisinages
# (recommendations, category_recommendations, related_series). L'ingestion
# elle-meme est gratuite : elle se branche sur les fiches deja telechargees
# par getMangaDetails et par l'hydratation (800/nuit). Ce job ne sert qu'au
# rattrapage du catalogue, en cron 07:00 + jitter 0-10 min (les creneaux MU
# 01:00 / 02:00 / 03:30 sont pris, l'hydratation enchainee finit vers 04:20).
# RECO_GRAPH_BACKFILL_PAGES_PER_RUN : fiches max par nuit (1500 x 2 s ~= 50
# min a 30 req/min). Ordre : bibliotheques, puis cibles deja recommandees,
# puis eligibles a l'accueil, puis les mieux notees.
# RECO_GRAPH_BACKFILL_REFRESH_DAYS : une serie deja visitee n'est relue
# qu'apres ce delai (colonne `manga.reco_graph_attempted_at`) — le graphe MU
# bouge peu, et c'est ce filigrane qui garantit la progression nuit apres
# nuit. Un seul job MU a la fois (verrou partage). ENABLED force a false si
# NODE_ENV=test.
RECO_GRAPH_BACKFILL_ENABLED=true
RECO_GRAPH_BACKFILL_PAGES_PER_RUN=1500
RECO_GRAPH_BACKFILL_REFRESH_DAYS=60

# ─── SMTP (Brevo) ─────────────────────────────────────────────────
# Voir https://www.brevo.com → SMTP & API → Paramètres SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@bladeburu.com
SMTP_FROM_NAME=Manga Tracker

# ─── URLs publiques ─────────────────────────────────────────────
# Trois variables, trois rôles distincts :
#
#   PUBLIC_WEB_URL       : base utilisée dans les LIENS EMAIL (verify,
#                          reset password). DOIT correspondre au host
#                          déclaré dans AndroidManifest <intent-filter>
#                          et dans le DeepLinkHandler côté Flutter,
#                          sinon les magic links n'ouvriront pas l'app.
#
#   GOOGLE_CALLBACK_URL  : URL de retour après login Google (côté API).
#                          Doit être déclarée dans la console Google
#                          Cloud → OAuth 2.0 → Authorized redirect URIs.
#
#   (côté Flutter)
#   MT_API_URL           : base URL que le client mobile utilise pour
#                          appeler l'API. Définie dans .env.development
#                          / .env.production du projet Flutter.
#
# Pour Manga Tracker, ces 3 URLs partagent le même host `api.bladeburu.com`
# car il n'y a pas de site web séparé sur le domaine racine.
#
# En dev local :
#   PUBLIC_WEB_URL=http://localhost:3000
#   GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
#   (Flutter) MT_API_URL=http://10.0.2.2:3000  (émulateur Android)
#
# En prod :
PUBLIC_WEB_URL=https://api.bladeburu.com
GOOGLE_CALLBACK_URL=https://api.bladeburu.com/auth/google/callback

# ─── Android App Links ─────────────────────────────────────────
# Servent à générer /.well-known/assetlinks.json (well-known.controller.ts).
#
# Pour trouver le SHA-256 de votre keystore :
#   keytool -list -v -keystore <path.jks> -alias <alias>
#
# Debug : ~/.android/debug.keystore (alias androiddebugkey, password "android")
# Release : votre upload-keystore.jks
#
# Si Play App Signing actif, ajoutez aussi le SHA-256 du Play Console
# (Setup → App Integrity → App Signing key certificate), séparé par virgule :
#   ANDROID_SHA256_FINGERPRINT=AB:CD:...:EF,12:34:...:78
ANDROID_PACKAGE_NAME=com.example.manga_tracker
ANDROID_SHA256_FINGERPRINT=

# ─── Apple Universal Links (iOS, à venir) ───────────────────────
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=

# ─── Recommandations ────────────────────────────────────────────
# Taille de la liste canonique de recommandations calculée et mise en cache
# par utilisateur (la pagination n'est qu'un slice de cette liste). Défaut :
# 500 = limite max d'une page. Borné à [500, 2000]. Coût mesuré : ~460 o de
# tas par carte, soit ~230 Kio pour une liste pleine de 500.
RECO_CANONICAL_MAX_ITEMS=
